# Copy to .env on the EC2 host and fill in real secret values.
# docker-compose.yml reads this file for all 3 worker containers.
# These are the same values/schedules the retired GitHub Actions workflows used to set.

GET_BRANDS_API=
PASSWORD_AES_KEY=
PIPELINE_AUTH_HEADER=

# --- daily-product-utm-worker (was product-utm-daily.yml, every 10 min) ---
DAILY_WORKER_CRON=3,13,23,33,43,53 * * * *
TOP_PRODUCT_LIMIT=10
TOP_PRODUCT_LOOKBACK_DAYS=30

# --- retrospective-product-utm-worker (was product-utm-retrospective.yml, every 2 days) ---
RETROSPECTIVE_WORKER_CRON=0 0 */2 * *
RETROSPECTIVE_DAYS=2

# --- global-utm-retrospective-worker (was global-utm-retrospective.yml, daily 18:35 UTC) ---
GLOBAL_RETROSPECTIVE_CRON=35 18 * * *
GLOBAL_RETROSPECTIVE_LOOKBACK_DAYS=2
MAX_BRAND_RETRIES=3

# --- shared GraphQL/DB tuning (previously also set in the workflow env: blocks) ---
GRAPHQL_MIN_BALANCE=100
GRAPHQL_MAX_RETRIES=3
GRAPHQL_BASE_BACKOFF_SECONDS=2
GRAPHQL_SLEEP_BUFFER_SECONDS=1
DB_BATCH_SIZE=500

# --- load-reduction knobs (these defaults apply if unset; 0 disables where noted) ---
# Webhook pipeline: rebuild dates older than the latest at most this often (0 = every trigger).
PRIOR_DAY_REBUILD_INTERVAL_SECONDS=3600
# Global retrospective worker: how long to wait for a brand's lock held by another run.
GLOBAL_WORKER_LOCK_WAIT_SECONDS=900
# Cache the brand list (seconds, 0 = off) and the 10-min worker's top-products result.
BRANDS_CACHE_TTL_SECONDS=1800
TOP_PRODUCTS_CACHE_TTL_SECONDS=3600
# utm-pipeline-api: set explicitly. In code SELF_RUN defaults to true when unset.
SELF_RUN=false
